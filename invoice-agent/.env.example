# Copy to .env and adjust. .env is gitignored; never commit real values.

# Local ports
EXTRACTOR_PORT=8101
MOCK_ACCOUNTING_PORT=8102

# Folder that POST /extract {"path": ...} may read PDFs from (default: invoice-agent/inbox)
INBOX_DIR=inbox
# Folder for the duplicate-check SQLite file (default: invoice-agent/data, gitignored)
DATA_DIR=data

# Folder for approved reminders (default: invoice-agent/outbox, gitignored).
# Approved reminders are only written here. Nothing is emailed.
OUTBOX_DIR=outbox

# B2 n8n (docker-compose.yml). n8n runs on http://localhost:5690.
N8N_PORT=5690
# Random secret that encrypts n8n's stored settings. Generate your own, e.g.
#   .venv\Scripts\python -c "import secrets; print(secrets.token_hex(32))"
# and paste it into .env (never into this file).
N8N_ENCRYPTION_KEY=

# B3 Airtable: base id (app...) from the base URL, and a personal access token scoped to that base only
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
