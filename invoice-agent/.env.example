# Copy to .env and adjust. .env is gitignored; never commit real values.

# Local ports
EXTRACTOR_PORT=8101
MOCK_ACCOUNTING_PORT=8102

# Folder that POST /extract {"path": ...} may read PDFs from (default: invoice-agent/inbox)
INBOX_DIR=inbox
# Folder for the duplicate-check SQLite file (default: invoice-agent/data, gitignored)
DATA_DIR=data

# Later milestones (B3 Airtable, B2 n8n). Not used in B1.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
N8N_PORT=5690
