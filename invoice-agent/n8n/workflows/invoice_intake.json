{
  "id": "InvoiceIntake001",
  "name": "Invoice intake",
  "nodes": [
    {
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Invoice webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "b1000000-0000-4000-8000-0000000000a1",
      "parameters": {
        "httpMethod": "POST",
        "path": "invoice",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Extract fields",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8101/extract",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ path: $json.body.filename }) }}",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Check duplicate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8101/check-duplicate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ file_id: $json.file_id, vendor: $json.fields.vendor, invoice_number: $json.fields.invoice_number, total: $json.fields.total }) }}",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Is duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Record duplicate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8101/outcomes",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ file_id: $('Extract fields').item.json.file_id, status: 'duplicate', detail: 'same invoice as ' + $json.original }) }}",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Needs review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1000000-0000-4000-8000-000000000002",
              "leftValue": "={{ $('Extract fields').item.json.stop_for_review }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Record needs review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        260
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8101/outcomes",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ file_id: $('Extract fields').item.json.file_id, status: 'needs_review', detail: $('Extract fields').item.json.blocking_flags.join(', ') }) }}",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Get payment status (MOCK)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        500
      ],
      "parameters": {
        "url": "=http://mock-accounting:8102/invoices/{{ $('Extract fields').item.json.fields.invoice_number }}/payment-status",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Unpaid and overdue?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        500
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1000000-0000-4000-8000-000000000003",
              "leftValue": "={{ ['unpaid', 'partial'].includes($json.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "c1000000-0000-4000-8000-000000000004",
              "leftValue": "={{ $('Extract fields').item.json.fields.due_date < ($env.REMINDER_TODAY || $now.toFormat('yyyy-MM-dd')) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "Record no reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        680
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8101/outcomes",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ file_id: $('Extract fields').item.json.file_id, status: 'no_reminder', detail: 'payment ' + $json.status + ', due ' + $('Extract fields').item.json.fields.due_date }) }}",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "Create reminder draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8101/drafts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ file_id: $('Extract fields').item.json.file_id, fields: $('Extract fields').item.json.fields, flags: $('Extract fields').item.json.flags, payment_status: $json.status, amount_paid: $json.amount_paid, today: $env.REMINDER_TODAY || $now.toFormat('yyyy-MM-dd'), resume_url: $execution.resumeUrl }) }}",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "Wait for human approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1760,
        400
      ],
      "webhookId": "b1000000-0000-4000-8000-0000000000a2",
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000013",
      "name": "Record decision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://api:8101/drafts/{{ $('Create reminder draft').item.json.id }}/decision",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ decision: $json.body.decision }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Invoice webhook": {
      "main": [
        [
          {
            "node": "Extract fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract fields": {
      "main": [
        [
          {
            "node": "Check duplicate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check duplicate": {
      "main": [
        [
          {
            "node": "Is duplicate?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is duplicate?": {
      "main": [
        [
          {
            "node": "Record duplicate",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Needs review?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs review?": {
      "main": [
        [
          {
            "node": "Record needs review",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Get payment status (MOCK)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get payment status (MOCK)": {
      "main": [
        [
          {
            "node": "Unpaid and overdue?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unpaid and overdue?": {
      "main": [
        [
          {
            "node": "Create reminder draft",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Record no reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create reminder draft": {
      "main": [
        [
          {
            "node": "Wait for human approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for human approval": {
      "main": [
        [
          {
            "node": "Record decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "InvoiceErrors001"
  },
  "active": false
}
