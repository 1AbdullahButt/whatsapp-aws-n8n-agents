# Copy to .env and fill in. Never commit .env.

# Meta for Developers > your app > WhatsApp > API Setup: temporary or system-user access token
WHATSAPP_TOKEN=
# Same page: "Phone number ID" of the test number (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Meta app > App settings > Basic > App secret (used to check X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# Any string you choose; type the same value in WhatsApp > Configuration > Webhook
WHATSAPP_VERIFY_TOKEN=

# Local storage (paths are relative to tenant-desk)
DB_PATH=data/tenant_desk.db
MEDIA_DIR=media

# Voice notes: "whisper" (needs requirements-voice.txt) or "fake" (fixed text, no install)
TRANSCRIBER=whisper

PORT=8001
